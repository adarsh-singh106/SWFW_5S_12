# Configuration and Topology Definitions for GCE Fleet Manager Deployment
# Sourced by all GCE deployment and acceptance automation scripts.

export GCP_PROJECT="project-3682976b-7d4a-465a-933"
export GCP_ZONE="asia-south1-a"

# VM Names
export CONTROLLER_VM="fleet-controller"
export NODE_A_VM="fleet-node-a"
export NODE_B_VM="fleet-node-b"
export NODE_C_VM="fleet-node-c"

# Internal IP Addresses
export CONTROLLER_IP="10.160.0.2"
export NODE_A_IP="10.160.0.5"
export NODE_B_IP="10.160.0.3"
export NODE_C_IP="10.160.0.4"

# SSH and User Credentials
export NODE_SSH_USER="fleetbootstrap"
export CONTROLLER_SERVICE_USER="fleet-manager"
export BOOTSTRAP_KEY_PATH="${HOME}/.ssh/fleet-bootstrap"
export INSTALLED_PRIVATE_KEY="/etc/fleet-manager/id_ed25519"
export INSTALLED_KNOWN_HOSTS="/var/lib/fleet-manager/known_hosts"

# Service Ports
export FLEET_MANAGER_PORT=8000
export GRAFANA_PORT=3000
export PROMETHEUS_PORT=9090
export NODE_EXPORTER_PORT=9100

# Application Paths on Controller
export APP_DIR="/opt/fleet-manager"
export CONFIG_DIR="/etc/fleet-manager"
export DATA_DIR="/var/lib/fleet-manager"
export BACKUP_DIR="/var/backups/fleet-manager"
