# Fleet Manager Environment Configuration Template
# Copy this file to /etc/fleet-manager/fleet-manager.env and restrict permissions:
#   sudo install -m 600 -o fleet-manager -g fleet-manager fleet-manager.env.example /etc/fleet-manager/fleet-manager.env

# ------------------------------------------------------------------------------
# 1. API Security Boundary (REQUIRED)
# ------------------------------------------------------------------------------
# 32-128 character URL-safe secret token representing the local operator.
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Do NOT commit or share this token. Retained only as SHA-256 digest in memory.
FLEET_MANAGER_API_TOKEN=REPLACE_WITH_GENERATED_32_TO_128_CHAR_SECRET_TOKEN

# ------------------------------------------------------------------------------
# 2. Storage & Persistence
# ------------------------------------------------------------------------------
# Path to SQLite database. Directory must be writable by the fleet-manager service user.
FLEET_MANAGER_DATABASE_PATH=/var/lib/fleet-manager/inventory.db

# ------------------------------------------------------------------------------
# 3. SSH Connectivity & Least-Privilege Credentials (REQUIRED for SSH operations)
# ------------------------------------------------------------------------------
# Remote service username configured on managed Linux nodes (must NOT be root).
# Reference deployment on Google Cloud uses 'fleetbootstrap' (installed via GCE metadata).
FLEET_MANAGER_SSH_USERNAME=fleetbootstrap

# Path to known_hosts file containing pinned host public keys.
# Must reside in /var/lib/fleet-manager/ (writable by the service user) because the
# application dynamically locks, stages, and enrolls trusted host keys at runtime
# via POST /api/nodes/{id}/trust-host-key. (/etc/fleet-manager is ReadOnlyPaths under systemd).
FLEET_MANAGER_SSH_KNOWN_HOSTS=/var/lib/fleet-manager/known_hosts

# Path to private key file for publickey authentication.
# Permissions MUST be 0600 and owned by the fleet-manager service user.
FLEET_MANAGER_SSH_PRIVATE_KEY=/etc/fleet-manager/id_ed25519

# SSH Concurrency & Admission Limits
FLEET_MANAGER_SSH_MAX_CONCURRENT=4
FLEET_MANAGER_SSH_TOTAL_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------------------
# 4. Observation Freshness & Automatic Monitoring
# ------------------------------------------------------------------------------
# Observation TTL in seconds. Older observations transition to STALE.
FLEET_MANAGER_OBSERVATION_TTL_SECONDS=180

# Background scheduler check interval in seconds.
FLEET_MANAGER_MONITORING_INTERVAL_SECONDS=60.0

# Uniform random jitter ratio (0.0 - 0.5) to avoid thundering herds.
FLEET_MANAGER_MONITORING_JITTER_RATIO=0.10

# Enable/disable background periodic connectivity checks (true/false).
FLEET_MANAGER_MONITORING_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Controlled Remote Operations
# ------------------------------------------------------------------------------
# Bounded timeout for read-only remote execution (seconds).
FLEET_MANAGER_OPERATION_TOTAL_TIMEOUT_SECONDS=15.0

# Memory limit for command output capture in bytes (default: 64 KiB).
FLEET_MANAGER_OPERATION_MAX_OUTPUT_BYTES=65536

# Max concurrent running remote operations across all nodes.
FLEET_MANAGER_OPERATION_MAX_CONCURRENT=4
